{
  "name": "moonestates",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n client,api -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace moonestates-client",
    "dev:server": "npm run dev --workspace moonestates-server",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace moonestates-server",
    "prisma:push": "npm run prisma:push --workspace moonestates-server"
  },
  "devDependencies": {
    "concurrently": "9.2.4",
    "typescript": "5.9.3"
  }
}
