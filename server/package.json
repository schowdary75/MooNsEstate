{
  "name": "moonestates-server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx src/seed-demo.ts",
    "admin:reset": "tsx reset-admin.ts",
    "admin:verify": "tsx verify-admin.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:reconcile": "tsx src/reconcile-migration.ts",
    "prisma:backfill-inventory": "tsx src/backfill-property-inventory.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "bcrypt": "6.0.0",
    "bullmq": "5.81.2",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "socket.io": "4.8.1",
    "stripe": "18.5.0",
    "svix": "1.99.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.19.11",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
