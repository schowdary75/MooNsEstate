datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid()) @map("_id")
  username     String    @unique
  password     String
  role         String    @default("user")
  emailsent    Int       @default(0)
  textsent     Int       @default(0)
  outboundcall Int       @default(0)
  phoneNumber  Float?
  firstName    String?
  lastName     String?
  roles        Json?
  createdDate  DateTime  @default(now())
  updatedDate  DateTime  @updatedAt
  deleted      Boolean   @default(false)
  memberships  Membership[]
  sessions     Session[]

  @@map("user_records")
}

model Organization {
  id                    String       @id @default(uuid()) @map("_id")
  name                  String
  slug                  String       @unique
  currency              String       @default("INR")
  timezone              String       @default("Asia/Kolkata")
  locale                String       @default("en-IN")
  logoUrl               String?
  primaryColor          String       @default("#0a0a0a")
  portalEnabled         Boolean      @default(true)
  subscriptionProvider  String       @default("razorpay")
  recordingRetentionDays Int         @default(180)
  createdDate           DateTime     @default(now())
  updatedDate           DateTime     @updatedAt
  deleted               Boolean      @default(false)
  memberships           Membership[]
  sessions              Session[]
  subscriptions         Subscription[]
  roles                 Role[]
  permissions           Permission[]

  @@map("organization_records")
}

model OrganizationDomain {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  hostname       String   @unique
  verified       Boolean  @default(false)
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_domain_records")
}

model Membership {
  id             String       @id @default(uuid()) @map("_id")
  organizationId String
  userId         String
  role           String       @default("agent")
  roleId         String?
  status         String       @default("active")
  createdDate    DateTime     @default(now())
  updatedDate    DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRecord     Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("membership_records")
}

model Role {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String
  name           String
  label          String
  description    String?          @db.Text
  system         Boolean          @default(false)
  createdDate    DateTime         @default(now())
  updatedDate    DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  permissions    RolePermission[]

  @@unique([organizationId, name])
  @@map("role_records")
}

model Permission {
  id             String           @id @default(uuid()) @map("_id")
  organizationId String
  key            String
  description    String?          @db.Text
  createdDate    DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles          RolePermission[]

  @@unique([organizationId, key])
  @@map("permission_records")
}

model RolePermission {
  id             String     @id @default(uuid()) @map("_id")
  organizationId String
  roleId         String
  permissionId   String
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdDate    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([organizationId])
  @@map("role_permission_records")
}

model Session {
  id             String        @id @default(uuid()) @map("_id")
  tokenHash      String        @unique
  userId         String
  organizationId String?
  userAgent      String?       @db.Text
  ipAddress      String?
  expiresAt      DateTime
  lastSeenAt     DateTime      @default(now())
  revokedAt      DateTime?
  createdDate    DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([organizationId])
  @@map("session_records")
}

model AuditEvent {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  ipAddress      String?
  metadata       Json?
  createdDate    DateTime @default(now())

  @@index([organizationId, createdDate])
  @@index([actorUserId, createdDate])
  @@map("audit_event_records")
}

model RoleAccess {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  roleName    String
  access      Json?
  description String?  @db.Text
  modifyDate  DateTime @default(now())
  createdDate DateTime @default(now())
  deleted     Boolean  @default(false)

  @@unique([organizationId, roleName])
  @@map("role_access_records")
}

model Lead {
  id              String   @id @default(uuid()) @map("_id")
  organizationId  String
  leadName        String?
  leadEmail       String?
  leadPhoneNumber String?
  phoneE164       String?
  leadAddress     String?
  leadStatus      String?
  leadSource      String?
  priority        String   @default("Medium")
  notes           String?  @db.Text
  nextFollowUpDate DateTime?
  firstResponseDueAt DateTime?
  firstRespondedAt DateTime?
  convertedAt     DateTime?
  consentStatus   String   @default("unknown")
  preferredLanguage String @default("en-IN")
  metaLeadId      String?
  createBy        String?
  assignedTo      String?
  createdDate     DateTime @default(now())
  updatedDate     DateTime @updatedAt
  deleted         Boolean  @default(false)

  @@unique([organizationId, metaLeadId])
  @@index([organizationId, createdDate])
  @@index([organizationId, phoneE164])
  @@index([organizationId, leadEmail])
  @@map("lead_records")
}

model Contact {
  id               String   @id @default(uuid()) @map("_id")
  organizationId   String
  email            String?
  phone            String?
  title            String?
  fullName         String?
  physicalAddress  String?
  interestProperty Json?
  quotes           Json?
  createBy         String?
  createdDate      DateTime @default(now())
  updatedDate      DateTime @updatedAt
  deleted          Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("contact_records")
}

model Property {
  id                   String   @id @default(uuid()) @map("_id")
  organizationId       String
  slug                 String?
  propertyType         String?
  title                String?
  builder              String?
  propertyAddress      String?
  location             String?
  listingPrice         String?
  towerName            String?
  totalFloors          Int?
  floorNumber          Int?
  unitNumber           String?
  bedrooms             Int?
  bathrooms            Int?
  carpetArea           Int?
  facing               String?
  status               String?
  reraId               String?
  latitude             Float?
  longitude            Float?
  possessionDate       DateTime?
  published            Boolean  @default(false)
  priceUpdatedAt       DateTime?
  description          String?  @db.Text
  propertyPhotos       Json?
  photoLivingRoom      String?
  photoKitchen         String?
  photoRoom1           String?
  photoRoom2           String?
  photoWashroom        String?
  photoBalcony         String?
  virtualToursOrVideos Json?
  floorPlans           Json?
  propertyDocuments    Json?
  unitType             Json?
  units                Json?
  createBy             String?
  createdDate          DateTime @default(now())
  updatedDate          DateTime @updatedAt
  deleted              Boolean  @default(false)

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("property_records")
}

model CustomField {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  moduleName  String
  icon        String?
  no          Int?
  headings    Json?
  fields      Json?
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@unique([organizationId, moduleName])
  @@map("custom_field_records")
}

model Account {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  name           String?
  officePhone    Float?
  alternatePhone Float?
  website        String?
  fax            String?
  ownership      String?
  emailAddress   String?
  nonPrimaryEmail String?
  billingStreet  String?
  shippingStreet String?
  description    String?  @db.Text
  type           String?
  industry       String?
  assignUser     String?
  createBy       String?
  modifiedBy     String?
  createdDate    DateTime @default(now())
  modifiedDate   DateTime @updatedAt
  deleted        Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("account_records")
}

model Opportunity {
  id              String   @id @default(uuid()) @map("_id")
  organizationId  String
  leadId          String?
  opportunityName String?
  accountName     String?
  amount          String?
  stage           String?
  probability     String?
  closeDate       String?
  leadSource      String?
  description     String?  @db.Text
  assignUser      String?
  createBy        String?
  createdDate     DateTime @default(now())
  updatedDate     DateTime @updatedAt
  deleted         Boolean  @default(false)

  @@index([organizationId, stage])
  @@index([leadId])
  @@map("opportunity_records")
}

model OpportunityProject {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  projectName String?
  createBy    String?
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId])
  @@map("opportunity_project_records")
}

model Invoice {
  id            String   @id @default(uuid()) @map("_id")
  organizationId String
  title         String?
  invoiceNumber String?
  status        String?
  grandTotal    String?
  items         Json?
  account       String?
  contact       String?
  createBy      String?
  createdDate   DateTime @default(now())
  updatedDate   DateTime @updatedAt
  deleted       Boolean  @default(false)

  @@index([organizationId, status])
  @@map("invoice_records")
}

model Quote {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  title       String?
  quoteNumber String?
  status      String?
  grandTotal  String?
  items       Json?
  account     String?
  contact     String?
  createBy    String?
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId, status])
  @@map("quote_records")
}

model Task {
  id              String   @id @default(uuid()) @map("_id")
  organizationId  String
  title           String?
  category        String?
  description     String?  @db.Text
  notes           String?  @db.Text
  assignTo        String?
  assignToLead    String?
  reminder        String?
  start           String?
  end             String?
  backgroundColor String?
  borderColor     String?
  textColor       String?
  display         String?
  url             String?
  allDay          Boolean?
  createBy        String?
  status          String   @default("todo")
  createdDate     DateTime @default(now())
  updatedDate     DateTime @updatedAt
  deleted         Boolean  @default(false)

  @@index([organizationId, status])
  @@map("task_records")
}

model Meeting {
  id           String   @id @default(uuid()) @map("_id")
  organizationId String
  agenda       String?
  attendes     Json?
  attendesLead Json?
  location     String?
  related      String?
  dateTime     String?
  notes        String?  @db.Text
  createBy     String?
  createdDate  DateTime @default(now())
  updatedDate  DateTime @updatedAt
  deleted      Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("meeting_records")
}

model PhoneCall {
  id            String   @id @default(uuid()) @map("_id")
  organizationId String
  sender        String?
  recipient     String?
  callDuration  String?
  startDate     String?
  endDate       String?
  createByLead  String?
  createBy      String?
  createByContact String?
  callNotes     String?  @db.Text
  createdDate   DateTime @default(now())
  updatedDate   DateTime @updatedAt
  deleted       Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("phone_call_records")
}

model Email {
  id            String   @id @default(uuid()) @map("_id")
  organizationId String
  sender        String?
  recipient     String?
  subject       String?
  message       String?  @db.Text
  createByLead  String?
  createBy      String?
  createByContact String?
  html          String?  @db.Text
  createdDate   DateTime @default(now())
  updatedDate   DateTime @updatedAt
  deleted       Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("email_records")
}

model TextMsg {
  id            String   @id @default(uuid()) @map("_id")
  organizationId String
  sender        String?
  to            String?
  message       String?  @db.Text
  createByLead  String?
  createBy      String?
  createByContact String?
  createdDate   DateTime @default(now())
  updatedDate   DateTime @updatedAt
  deleted       Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("text_msg_records")
}

model Document {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  folderName  String?
  files       Json?
  createBy    String?
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId, createdDate])
  @@map("document_records")
}

model Validation {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  name        String?
  value       String?
  message     String?
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId])
  @@map("validation_records")
}

model EmailTemplate {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  name        String?
  subject     String?
  html        String?  @db.Text
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId])
  @@map("email_template_records")
}

model ModuleActiveDeactive {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  moduleName  String?
  isActive    Boolean  @default(true)
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId])
  @@map("module_active_records")
}

model BankDetails {
  id            String   @id @default(uuid()) @map("_id")
  organizationId String
  bankName      String?
  accountNumber String?
  ifscCode      String?
  branch        String?
  createdDate   DateTime @default(now())
  updatedDate   DateTime @updatedAt
  deleted       Boolean  @default(false)

  @@index([organizationId])
  @@map("bank_details_records")
}

model ImagesSchema {
  id          String   @id @default(uuid()) @map("_id")
  organizationId String
  authImg     String?
  logoImg     String?
  logoSmImg   String?
  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  deleted     Boolean  @default(false)

  @@index([organizationId])
  @@map("images_schema_records")
}

model FollowUp {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  leadId         String
  ownerId        String?
  followUpType   String
  followUpDate   DateTime
  priority       String   @default("medium")
  status         String   @default("pending")
  notes          String?  @db.Text
  outcome        String?  @db.Text
  providerJobId  String?
  failureReason  String?  @db.Text
  completedAt    DateTime?
  createdBy      String?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt
  deleted        Boolean  @default(false)

  @@index([organizationId, followUpDate])
  @@index([leadId, status])
  @@map("follow_up_records")
}

model AutomationSequence {
  id                String   @id @default(uuid()) @map("_id")
  organizationId    String
  name              String
  description       String?  @db.Text
  triggerType       String   @default("manual")
  steps             Json
  status            String   @default("active")
  pauseOnConversion Boolean  @default(true)
  createdBy         String?
  createdDate       DateTime @default(now())
  updatedDate       DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("automation_sequence_records")
}

model AutomationEnrollment {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  sequenceId     String
  leadId         String
  status         String   @default("active")
  currentStep    Int      @default(0)
  nextRunAt      DateTime?
  pausedReason   String?  @db.Text
  lastError      String?  @db.Text
  createdBy      String?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@index([organizationId, status, nextRunAt], map: "automation_enrollment_org_status_run_idx")
  @@index([leadId, createdDate])
  @@map("automation_enrollment_records")
}

model ActivityEvent {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  leadId         String?
  contactId      String?
  propertyId     String?
  actorUserId    String?
  type           String
  title          String
  description    String?  @db.Text
  metadata       Json?
  occurredAt     DateTime @default(now())
  createdDate    DateTime @default(now())

  @@index([organizationId, occurredAt])
  @@index([leadId, occurredAt])
  @@map("activity_event_records")
}

model ConsentRecord {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  leadId         String?
  buyerProfileId String?
  channel        String
  purpose        String
  status         String
  source         String?
  proof          Json?
  capturedAt     DateTime @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?

  @@index([organizationId, channel, status])
  @@index([leadId])
  @@map("consent_record_records")
}

model SuppressionEntry {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  channel        String
  address        String
  reason         String
  provider       String?
  createdDate    DateTime @default(now())

  @@unique([organizationId, channel, address])
  @@map("suppression_entry_records")
}

model ReconciliationItem {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  channel        String
  identifier     String
  candidateLeadIds Json
  payload        Json
  status         String   @default("pending")
  resolvedLeadId String?
  resolvedBy     String?
  resolvedAt     DateTime?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@index([organizationId, status, createdDate], map: "reconciliation_org_status_created_idx")
  @@map("reconciliation_item_records")
}

model ChannelAccount {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  channel        String
  provider       String
  displayName    String?
  externalId     String?
  status         String   @default("setup_required")
  encryptedConfig String? @db.LongText
  lastHealthAt   DateTime?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@unique([organizationId, channel, provider])
  @@map("channel_account_records")
}

model Conversation {
  id                    String   @id @default(uuid()) @map("_id")
  organizationId        String
  channelAccountId      String?
  leadId                String?
  contactId             String?
  channel               String
  providerConversationId String?
  subject               String?
  status                String   @default("open")
  priority              String   @default("normal")
  assignedTo            String?
  unreadCount           Int      @default(0)
  customerWindowEndsAt  DateTime?
  lastMessageAt         DateTime?
  createdDate           DateTime @default(now())
  updatedDate           DateTime @updatedAt

  @@index([organizationId, status, lastMessageAt])
  @@index([leadId, channel])
  @@map("conversation_records")
}

model Message {
  id                String   @id @default(uuid()) @map("_id")
  organizationId    String
  conversationId    String
  providerMessageId String?
  direction         String
  type              String   @default("text")
  sender            String?
  recipient         String?
  text              String?  @db.LongText
  html              String?  @db.LongText
  templateName      String?
  status            String   @default("queued")
  replyToMessageId  String?
  errorCode         String?
  errorMessage      String?  @db.Text
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdBy         String?
  metadata          Json?
  createdDate       DateTime @default(now())
  updatedDate       DateTime @updatedAt

  @@unique([organizationId, providerMessageId])
  @@index([conversationId, createdDate])
  @@map("message_records")
}

model MessageAttachment {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  messageId      String
  fileName       String?
  mimeType       String?
  sizeBytes      Int?
  storageKey     String?
  providerMediaId String?
  externalUrl    String?  @db.Text
  createdDate    DateTime @default(now())

  @@index([messageId])
  @@map("message_attachment_records")
}

model DeliveryEvent {
  id              String   @id @default(uuid()) @map("_id")
  organizationId  String
  messageId       String?
  providerEventId String?
  status          String
  payload         Json?
  occurredAt      DateTime
  createdDate     DateTime @default(now())

  @@unique([organizationId, providerEventId])
  @@index([messageId, occurredAt])
  @@map("delivery_event_records")
}

model ProviderWebhookEvent {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String?
  provider       String
  externalEventId String
  eventType      String?
  status         String   @default("received")
  payload        Json
  errorMessage   String?  @db.Text
  processedAt    DateTime?
  receivedAt     DateTime @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, status, receivedAt])
  @@map("provider_webhook_event_records")
}

model CallRecord {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  leadId         String?
  contactId      String?
  provider       String   @default("exotel")
  providerCallId String?
  direction      String
  fromNumber     String?
  toNumber       String?
  agentUserId    String?
  status         String   @default("queued")
  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSeconds Int?
  consentedToRecording Boolean @default(false)
  notes          String?  @db.Text
  metadata       Json?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@unique([organizationId, providerCallId])
  @@index([leadId, createdDate])
  @@map("call_record_records")
}

model CallRecording {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  callId         String   @unique
  storageKey     String?
  providerUrl    String?  @db.Text
  mimeType       String?
  durationSeconds Int?
  retentionUntil DateTime?
  legalHold      Boolean  @default(false)
  createdDate    DateTime @default(now())

  @@index([organizationId, retentionUntil])
  @@map("call_recording_records")
}

model Transcript {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  callId         String   @unique
  provider       String   @default("sarvam")
  providerJobId  String?
  languageCode   String?
  status         String   @default("queued")
  text           String?  @db.LongText
  diarized       Json?
  timestamps     Json?
  errorMessage   String?  @db.Text
  completedAt    DateTime?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@index([organizationId, status])
  @@map("transcript_records")
}

model EmailThread {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  conversationId String   @unique
  providerThreadId String?
  rootMessageId  String?
  references     Json?
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@index([organizationId])
  @@map("email_thread_records")
}

model IntegrationConnection {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  provider       String
  status         String   @default("setup_required")
  encryptedConfig String? @db.LongText
  externalAccountId String?
  expiresAt      DateTime?
  lastSyncAt     DateTime?
  lastError      String?  @db.Text
  createdDate    DateTime @default(now())
  updatedDate    DateTime @updatedAt

  @@unique([organizationId, provider])
  @@map("integration_connection_records")
}

model MetaCampaign {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String
  externalId     String
  name           String
  objective      String?
  status         String?
  effectiveStatus String?
  dailyBudget    String?
  lifetimeBudget String?
